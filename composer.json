{
    "name": "saeidsharafi/changelog",
    "description": "a package to show CHANGELOG.md to users",
    "keywords": [
        "saeidsharafi",
        "changelog"
    ],
    "homepage": "https://github.com/saeidsharafi/laravel-changelog",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Saeid Sharafi",
            "email": "saeidsharafi263@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.1|^8.2",
        "illuminate/support": "^8.0|^9.0|^10.0|^11.0|^12.0",
        "illuminate/console": "^9.0|^10.0|^11.0|^12.0",
        "illuminate/filesystem": "^9.0|^10.0|^11.0|^12.0",
        "illuminate/routing": "^9.0|^10.0|^11.0|^12.0",
        "illuminate/http": "^9.0|^10.0|^11.0|^12.0",
        "inertiajs/inertia-laravel": "^0.6|^0.11|^1.0|^2.0"
    },
    "require-dev": {
        "orchestra/testbench": "^6.23|^7.0|^8.0",
        "pestphp/pest": "^2.0",
        "pestphp/pest-plugin-laravel": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "SaeidSharafi\\Changelog\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SaeidSharafi\\Changelog\\Tests\\": "tests"
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "SaeidSharafi\\Changelog\\ChangelogServiceProvider"
            ],
            "aliases": {
                "Changelog": "SaeidSharafi\\Changelog\\ChangelogFacade"
            }
        }
    },
    "version": "2.0.0"
}
